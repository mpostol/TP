<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.diagnostics>
    <sources>
      <source name="LoggingSourse" 
              switchName="Switch" 
              switchType="System.Diagnostics.SourceSwitch">
        <listeners>
          <remove name="Default" />
          <add name="LogFile" />
        </listeners>
      </source>
    </sources>
    <switches>
      <add name="Switch" 
           value="All" />
    </switches>
    <sharedListeners>
      <add name="LogFile" 
           type="System.Diagnostics.DelimitedListTraceListener" 
           initializeData="LoggingConsumer.log" 
           traceOutputOptions="DateTime">
        <filter type="System.Diagnostics.EventTypeFilter" 
                initializeData="All" />
      </add>
    </sharedListeners>
    <trace autoflush="true" indentsize="5" />
  </system.diagnostics>
</configuration>